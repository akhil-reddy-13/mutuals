# Copy to .env.local and fill in. NEVER commit .env.local.
MUSE_API_KEY=
# Exact value from the dev.meta.ai docs quickstart (OpenAI-SDK compatible base URL)
MUSE_BASE_URL=
MODEL_WONDER=muse-wonder-1.0
MODEL_SPARK=muse-spark-1.3
MODEL_EMBER=muse-ember-1.0
# true = never hit the API; serve cached responses, else deterministic mock output
MOCK_MUSE=false
