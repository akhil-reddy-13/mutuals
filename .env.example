# Copy to .env.local and fill in. NEVER commit .env.local.
MUSE_API_KEY=
# Exact value from the dev.meta.ai docs quickstart (OpenAI-SDK compatible base URL)
MUSE_BASE_URL=https://api.meta.ai/v1
MODEL_WONDER=muse-wonder-1.0
MODEL_SPARK=muse-spark-1.3
MODEL_EMBER=muse-ember-1.0
# true = never hit the API; serve cached responses, else deterministic mock output
MOCK_MUSE=false
# Reasoning effort per model (minimal|low|medium|high|default). Lower = faster. Defaults: spark/ember minimal, wonder low.
# MUSE_EFFORT_SPARK=minimal
# MUSE_EFFORT_EMBER=minimal
# MUSE_EFFORT_WONDER=low
